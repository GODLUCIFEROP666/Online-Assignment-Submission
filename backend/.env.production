# Production Environment Variables for Render Deployment
# Copy these and paste them using the "Add from .env" button on Render!

# General settings
APP_NAME=FINAL2 API
APP_ENV=production

# ----------------- DATABASE CONFIGURATION -----------------
# Paste your MongoDB Atlas Connection URI below. 
# Make sure to replace <db_password> with your actual database user password!
# Example: MONGODB_URI=mongodb+srv://admin:my-password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<YOUR-ATLAS-CLUSTER>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=final

# ----------------- SECURITY & COOKIES -----------------
# We have pre-generated secure, random keys for your production JWT secrets.
# You can keep these as they are, or generate new ones.
JWT_SECRET=4a7bde3c1081534062a4d95b54a72d1f9b3ec5ad1e847c20a3250d4f58c70e2a
JWT_REFRESH_SECRET=bf8a3de895c20c028ea7c55e921d7bfa541dcd79ae091176b5c3da49e0f6c128
JWT_ACCESS_EXPIRES_MINUTES=30
JWT_REFRESH_EXPIRES_DAYS=14

# ----------------- CORS SETTINGS -----------------
# CRITICAL: Replace the Vercel placeholder below with your actual live Vercel URL!
# Example: CORS_ORIGINS=https://final2-frontend.vercel.app
CORS_ORIGINS=https://<YOUR-VERCEL-FRONTEND-SUBDOMAIN>.vercel.app

# ----------------- SMTP (EMAIL) CONFIGURATION -----------------
# If your application sends emails, configure your production email credentials here:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=FINAL2 Portal
SMTP_FROM_EMAIL=your-email@gmail.com

# ----------------- UPLOADS & FILE STORAGE -----------------
# In production, Render's filesystem is ephemeral (files are deleted when the service restarts).
# Set UPLOAD_DIR to /var/data/uploads, and make sure to mount a Disk with this mount path 
# under the "Advanced" settings on Render!
UPLOAD_DIR=/var/data/uploads
MAX_UPLOAD_MB=25

